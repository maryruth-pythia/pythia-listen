# Get from console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Local JSON storage location (only used when POSTGRES_URL is unset)
PYTHIA_DATA_DIR=./data/runtime

# Shared password to gate the site. Anyone visiting the URL must enter this.
# Pick a phrase, not a word. Rotate by changing this and redeploying.
PYTHIA_PASSWORD=change-me

# Set in production deploy. When present, the app uses Postgres instead of
# local JSON storage. Vercel Postgres auto-injects this when you provision
# their database from the dashboard.
# POSTGRES_URL=postgresql://user:pass@host:port/db
