# ── Core ────────────────────────────────────────────────────────────────
# Shared-password gate (legacy / current default auth mode).
PYTHIA_PASSWORD=

# Local data dir for the JSON store (local dev only; unset uses a default).
PYTHIA_DATA_DIR=

# Postgres. Unset locally (JSON store is used). Auto-injected on Vercel.
POSTGRES_URL=

# Model / API keys (see lib/claude.ts).
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Per-org accounts (Better Auth) — OFF by default ─────────────────────
# Set AUTH_MODE=accounts ONLY on a deploy that has a Postgres URL + secret and
# has run the Better Auth schema migration. Leave unset to keep the shared
# password gate. See claude/pythia-accounts-multitenancy-plan.md.
AUTH_MODE=

# 32+ char high-entropy secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the deployment, e.g. https://your-app.vercel.app
BETTER_AUTH_URL=

# Transactional email for magic-link login + org invites (Resend).
# If unset in dev, links are logged to the server console instead of emailed.
RESEND_API_KEY=
EMAIL_FROM=Pythia <login@yourdomain>
